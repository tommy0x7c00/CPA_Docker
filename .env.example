# Copy this file to .env and set a valid GitHub personal access token locally.
# Docker Compose passes this value to CPA as both CLIPROXY_PLUGIN_STORE_TOKEN
# and GITHUB_TOKEN for authenticated GitHub requests and plugin store downloads.
# Leave empty to use unauthenticated GitHub requests with lower rate limits.
# Never commit .env or put real credentials in this template.
CLIPROXY_PLUGIN_STORE_TOKEN=
